  Assets:Марко:Банк              2860.40 PLN
  Equity:Марко:Початковий-залишок

; ----- Збережені запити -----
; person = друга частина назви рахунку (Оля або Марко), category = остання.
2026-07-31 query "витрати-за-категоріями" "SELECT year, month, leaf(root(account, 2)) AS person, leaf(account) AS category, sum(number) AS total WHERE account ~ '^Expenses:' GROUP BY year, month, person, category ORDER BY year, month, person, total DESC"
2026-07-31 query "норма-заощаджень" "SELECT year, month, leaf(root(account, 2)) AS person, -sum(number * int(root(account, 1) = 'Income')) AS income, sum(number * int(root(account, 1) = 'Expenses')) AS spent, -sum(number) AS saved, max(date) AS last_day WHERE account ~ '^(Income|Expenses):' GROUP BY year, month, person ORDER BY year, month, person"
2026-07-31 query "фіксовані-і-змінні" "SELECT year, month, leaf(root(account, 2)) AS person, 'fixed' IN tags AS fixed, sum(number) AS total WHERE account ~ '^Expenses:' GROUP BY year, month, person, fixed ORDER BY year, month, person, fixed"
2026-07-31 query "без-категорії" "SELECT year, month, date, account, narration, position WHERE account ~ ':Без-Категорії$' OR account ~ '^Income:.*:Інше$' ORDER BY date"
2026-07-31 query "готівка" "SELECT date, leaf(root(account, 2)) AS person, leaf(account) AS category, narration, number WHERE account ~ '^Expenses:' AND 'cash' IN tags ORDER BY date DESC"

include "transactions.beancount"
include "cash.beancount"
